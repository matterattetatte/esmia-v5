<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		{#- PNG icons instead of the 32 KB multi-resolution .ico, which browsers
			downloaded on every page view for a 16px image. #}
		<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png">
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		{# Google Fonts: Playfair Display (headings) + Nunito (body) #}
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Playfair+Display:wght@400;700;900&display=swap" rel="stylesheet">

		{#- Pages declare `preloadImage` in their front matter to preload their LCP image. #}
		{% if preloadImage %}{% imagePreload preloadImage, "hero" %}{% endif %}

		{% set canonicalUrl = (seo and seo.canonical) or canonical or (page.url | htmlBaseUrl(metadata.url)) %}
		<title>{% if title %}{{ title }} | {{ metadata.name }}{% else %}{{ metadata.title }}{% endif %}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		<link rel="canonical" href="{{ canonicalUrl }}">

		<script type="application/ld+json" eleventy:ignore>
		{
			"@context": "https://schema.org",
			"@type": "FoodEstablishment",
			"@id": "{{ metadata.url }}/#business",
			"name": {{ metadata.name | dump | safe }},
			"description": {{ metadata.description | dump | safe }},
			"url": "{{ metadata.url }}/",
			"email": {{ metadata.contact.email | dump | safe }},
			"telephone": {{ metadata.contact.phone | dump | safe }},
			"foundingDate": {{ metadata.foundingYear | dump | safe }},
			"servesCuisine": "Spanish",
			"address": {
				"@type": "PostalAddress",
				"streetAddress": {{ metadata.contact.streetAddress | dump | safe }},
				"postalCode": {{ metadata.contact.postalCode | dump | safe }},
				"addressLocality": {{ metadata.contact.addressLocality | dump | safe }},
				"addressCountry": {{ metadata.contact.country | dump | safe }}
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": 59.3921,
				"longitude": 18.0113
			},
			"openingHoursSpecification": [
				{
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
					"opens": "09:00",
					"closes": "17:00"
				},
				{
					"@type": "OpeningHoursSpecification",
					"dayOfWeek": "Saturday",
					"opens": "10:00",
					"closes": "15:00"
				}
			],
			"areaServed": {
				"@type": "City",
				"name": {{ metadata.contact.areaServed | dump | safe }}
			},
			"sameAs": [
				{{ metadata.social.facebook | dump | safe }}
			]
		}
		</script>
		{% if page.url and page.url != "/" and page.url != "/404.html" %}
		<script type="application/ld+json" eleventy:ignore>
		{
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "Start",
					"item": "{{ metadata.url }}/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": {{ (title or metadata.name) | dump | safe }},
					"item": "{{ canonicalUrl }}"
				}
			]
		}
		</script>
		{% endif %}

		{#- Uncomment this if you'd like folks to know that you used Eleventy to build your site!  #}
		{#- <meta name="generator" content="{{ eleventy.generator }}"> #}

		{#-
		Plain-text bundles are provided via the `eleventy-plugin-bundle` plugin:
		1. CSS:
			* Add to a per-page bundle using `{% css %}{% endcss %}`
			* Retrieve bundle content using `{% getBundle "css" %}` or `{% getBundleFileUrl "css" %}`
		2. Or for JavaScript:
			* Add to a per-page bundle using `{% js %}{% endjs %}`
			* Retrieve via `{% getBundle "js" %}` or `{% getBundleFileUrl "js" %}`
		3. Learn more: https://github.com/11ty/eleventy-plugin-bundle
		#}

		{#- Add CSS to the bundle #}
		<style>/* This is an arbitrary CSS string added to the bundle */</style>

		{#- Add the contents of a file to the bundle #}
		<style>{% include "css/index.css" %}</style>

		{#- Or you can add from node_modules #}
		{# <style>{% include "node_modules/something.css" %}</style> #}

		{#- Render the CSS bundle using inlined CSS (for the fastest site performance in production) #}
		<style>{% getBundle "css" %}</style>

		{#- Renders the CSS bundle using a separate file, if you can't set CSP directive style-src: 'unsafe-inline' #}
		{#- <link rel="stylesheet" href="{% getBundleFileUrl "css" %}"> #}

	</head>
	<body>
		<a href="#main" id="skip-link" class="visually-hidden">Skip to main content</a>

		<header class="flex">
			<a href="/" class="home-link">
              {# <img id="main-logo" src="" /> #}
				ESMIA HB
			</a>

			{#- Read more about `eleventy-navigation` at https://www.11ty.dev/docs/plugins/navigation/ #}
			<nav>
  <h2 class="visually-hidden">Top level navigation menu</h2>
  <ul class="nav" id="primary-nav">
 		<li class="nav-item">	 	
        <a href="/"
		{% if page.url === '/' %} aria-current="page" {% endif %}
		>
          Start
        </a>
    </li>
    {%- for entry in collections.all | eleventyNavigation %}
      <li class="nav-item">	 	
        <a href="{{ entry.url }}"
		{% if entry.url == page.url or page.url.includes(entry.url) %}aria-current="page"{% endif %}
		>
          {{ entry.title }}
        </a>
      </li>
    {%- endfor %}
  </ul>
  <button type="button" class="nav-toggle" aria-label="Meny" aria-expanded="false" aria-controls="primary-nav">
    <span class="hamburger"></span>
  </button>
</nav>

		</header>

		<main id="main">
			{{ content | safe }}
		</main>

		<footer>
			<p class="footer-nap">
				{{ metadata.name }} · {{ metadata.contact.streetAddress }} · {{ metadata.contact.postalCode }} {{ metadata.contact.addressLocality }} ({{ metadata.contact.areaServed }}) ·
				<a href="mailto:{{ metadata.contact.email }}">{{ metadata.contact.email }}</a> ·
				<a href="tel:{{ metadata.contact.phone }}">{{ metadata.contact.phoneDisplay }}</a>
			</p>
			<p>
				Copyright © 2026 {{ metadata.name }}
				&nbsp;
				<a href="/legal/">Juridiskt</a>
				&nbsp;
				<a href="/legal/privacy/">Integritetspolicy</a>
				&nbsp;
				<a href="/legal/cookies/">Cookiepolicy</a>
				&nbsp;
				<a href="/legal/terms/">Villkor</a>
			</p>
		</footer>

		<!-- This page `{{ page.url }}` was built on {% currentBuildDate %} -->
		<script type="module" src="{% getBundleFileUrl "js" %}"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const navToggle = document.querySelector('.nav-toggle');
    const nav = document.querySelector('.nav');
    if (!navToggle || !nav) return;

    function setOpen(open) {
      nav.classList.toggle('open', open);
      navToggle.setAttribute('aria-expanded', String(open));
    }

    navToggle.addEventListener('click', function () {
      const isOpen = nav.classList.contains('open');
      setOpen(!isOpen);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && nav.classList.contains('open')) {
        setOpen(false);
        navToggle.focus();
      }
    });
  });

  window.addEventListener('scroll', function() {
    const navbar = document.querySelector('header');
    const footer = document.querySelector('footer');

    if (navbar) {
      if (window.scrollY > 50) {
        navbar.classList.add('scrolled');
      } else {
        navbar.classList.remove('scrolled');
      }
    }

    if (footer) {
      const windowHeight = window.innerHeight;
      const documentHeight = document.documentElement.scrollHeight;
      const scrollPosition = window.scrollY + windowHeight;

      if (scrollPosition > documentHeight - 50) {
        footer.classList.add('scrolled');
      } else {
        footer.classList.remove('scrolled');
      }
    }
  }, { passive: true });
</script>

	</body>
</html>
