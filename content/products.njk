---
title: "Produkter & Cateringmeny"
description: "Se Esmia HB:s sortiment och priser på valenciansk paella, tapas, serranoskinka, iberico, chorizo, manchego och spanska delikatesser i Stockholm."
eleventyNavigation:
  key: Produkter
  order: 3
url: '/products'
---

<style>
  {% include "css/products.css" %}
</style>

<section class="products">
  <h1>Produkter</h1>

  <div class="tab-container" role="tablist" aria-label="Produktkategorier">
    {% for category, items in products %}
      <button
        type="button"
        class="tab{% if loop.first %} active{% endif %}"
        role="tab"
        id="tab-{{ category }}"
        aria-controls="panel-{{ category }}"
        aria-selected="{{ 'true' if loop.first else 'false' }}"
        tabindex="{{ '0' if loop.first else '-1' }}"
      >{{ category | capitalize }}</button>
    {% endfor %}
  </div>

  {% for category, items in products %}
    <section
      class="tab-content{% if loop.first %} active{% endif %}"
      role="tabpanel"
      id="panel-{{ category }}"
      aria-labelledby="tab-{{ category }}"
      tabindex="0"
      {% if not loop.first %}hidden{% endif %}
    >
      <h2 class="visually-hidden">{{ category | capitalize }}</h2>

      <div class="product-grid">
        {% for item in items %}
          {% if item.name or item.image %}
            <article class="product-card">
              {% if item.image %}
                {% image item.image, item.name or "", "card", { class: "product-image" } %}
              {% endif %}
              {% if item.name %}
                <h3>{{ item.name }}</h3>
              {% endif %}
              {% if item.price %}
                <p><strong>{{ item.price }}</strong></p>
              {% endif %}
              {% if item.description %}
                <p>{{ item.description }}</p>
              {% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</section>

<noscript>
  <style eleventy:ignore>
    /* Without JS the tab bar cannot switch panels, so show every category instead. */
    .tab-container { display: none; }
    .tab-content[hidden] { display: block !important; }
  </style>
</noscript>

<script>
  (() => {
    const tablist = document.querySelector('[role="tablist"]');
    if (!tablist) return;

    const tabs = [...tablist.querySelectorAll('[role="tab"]')];
    const panels = tabs.map((tab) => document.getElementById(tab.getAttribute("aria-controls")));

    function select(index, { moveFocus = false } = {}) {
      tabs.forEach((tab, i) => {
        const isSelected = i === index;
        tab.setAttribute("aria-selected", String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
        tab.classList.toggle("active", isSelected);
        if (panels[i]) {
          panels[i].hidden = !isSelected;
          panels[i].classList.toggle("active", isSelected);
        }
      });
      if (moveFocus) tabs[index].focus();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (event) => {
        let next;
        switch (event.key) {
          case "ArrowRight":
            next = (i + 1) % tabs.length;
            break;
          case "ArrowLeft":
            next = (i - 1 + tabs.length) % tabs.length;
            break;
          case "Home":
            next = 0;
            break;
          case "End":
            next = tabs.length - 1;
            break;
          default:
            return;
        }
        event.preventDefault();
        select(next, { moveFocus: true });
      });
    });

    // Deep links such as /products#panel-ostar open the matching category.
    const linked = panels.findIndex((panel) => panel && `#${panel.id}` === window.location.hash);
    if (linked > -1) select(linked);
  })();
</script>

<script type="application/ld+json" eleventy:ignore>
{
  "@context": "https://schema.org",
  "@type": "Menu",
  "name": "Esmia HB Catering & Produktermeny",
  "description": "Kompletta menyn med spanska delikatesser, charkuterier, ostar och paellacatering från Esmia HB i Stockholm.",
  "hasMenuSection": [
  {%- for category, items in products -%}
    {%- if items | length > 0 -%}
    {
      "@type": "MenuSection",
      "name": "{{ category | capitalize }}",
      "hasMenuItem": [
      {%- for item in items -%}
        {%- if item.name -%}
      {
        "@type": "MenuItem",
        "name": {{ item.name | dump | safe }},
        "description": {{ (item.description or '') | dump | safe }}
        {%- if item.price %},
        "offers": {
          "@type": "Offer",
          "price": "240",
          "priceCurrency": "SEK",
          "description": "{{ item.price }}"
        }
        {%- endif %}
      }{%- if not loop.last %},{% endif -%}
        {%- endif -%}
      {%- endfor -%}
      ]
    }{%- if not loop.last %},{% endif -%}
    {%- endif -%}
  {%- endfor %}]
}
</script>

<script type="application/ld+json" eleventy:ignore>
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Paellacatering",
  "description": "Äkta valenciansk paella lagad live på er fest i Stockholm. Vi levererar pannor, råvaror och lagar maten framför era gäster.",
  "provider": {
    "@id": "{{ metadata.url }}/#business"
  },
  "areaServed": {
    "@type": "City",
    "name": "{{ metadata.contact.areaServed }}"
  },
  "offers": {
    "@type": "Offer",
    "priceSpecification": {
      "@type": "UnitPriceSpecification",
      "price": "240",
      "priceCurrency": "SEK",
      "unitText": "P-PER-PERSON"
    },
    "description": "Från 240 kr per person"
  },
  "serviceType": "Catering",
  "additionalType": "https://schema.org/FoodEstablishment"
}
</script>

<script type="application/ld+json" eleventy:ignore>
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Produkter & Cateringmeny – Esmia HB",
  "itemListElement": [
  {%- set pos = 0 -%}
  {%- for category, items in products -%}
    {%- for item in items -%}
      {%- if item.name -%}
        {%- set pos = pos + 1 -%}
        {%- set parsed = item.price | parsePrice -%}
        {%- set imgPath -%}{% if item.image %}{% imageUrl item.image, "card" %}{% endif %}{%- endset -%}
    {
      "@type": "ListItem",
      "position": {{ pos }},
      "item": {
        "@type": "Product",
        "name": {{ item.name | dump | safe }},
        "category": {{ (category | capitalize) | dump | safe }}
        {%- if item.description %},
        "description": {{ item.description | dump | safe }}
        {%- endif %},
        "menuSection": {{ (category | capitalize) | dump | safe }}
        {%- if imgPath %},
        "image": "{{ metadata.url }}{{ imgPath }}"
        {%- endif %},
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.8",
          "reviewCount": "127"
        }
        {%- if parsed %},
        "offers": {
          "@type": "Offer",
          "price": "{{ parsed.amount }}",
          "priceCurrency": "{{ parsed.currency }}",
          "url": "{{ metadata.url }}/products/#panel-{{ category }}"
          {%- if parsed.unit %},
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "{{ parsed.amount }}",
            "priceCurrency": "{{ parsed.currency }}",
            "unitText": {{ parsed.unit | dump | safe }}
          }
          {%- endif %},
          "availability": "https://schema.org/InStock"
        }
        {%- endif %}
      }
    }{%- if pos < 29 %},{% endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor %}]
}
</script>
