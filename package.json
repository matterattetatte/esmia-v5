{
	"name": "eleventy-base-blog",
	"version": "9.0.0",
	"description": "A starter repository for a blog web site using the Eleventy site generator.",
	"type": "module",
	"scripts": {
		"build": "npx @11ty/eleventy && node scripts/validate-html.mjs",
		"test": "node --test test/*.test.js",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 npx @11ty/eleventy",
		"build-ghpages": "npx @11ty/eleventy --pathprefix=/eleventy-base-blog/",
		"start": "npx @11ty/eleventy --serve --quiet",
		"test:e2e": "npx playwright test",
		"verify:hosting": "node scripts/verify-hosting.mjs",
		"verify:agentic": "node scripts/verify-agentic.mjs",
		"lighthouse": "node scripts/lighthouse.mjs",
		"lighthouse:assert": "node scripts/lighthouse.mjs --runs=3 --assert",
		"lighthouse:chrome": "npx @puppeteer/browsers install chrome@156.0.8078.80 --path ./chrome",
		"deploy:preview": "npm run build && firebase hosting:channel:deploy lh-audit --expires 7d",
		"start-ghpages": "npx @11ty/eleventy --pathprefix=/eleventy-base-blog/ --serve --quiet",
		"debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy",
		"deploy": "npm run build && firebase deploy"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/11ty/eleventy-base-blog.git"
	},
	"author": {
		"name": "Zach Leatherman",
		"email": "zachleatherman@gmail.com",
		"url": "https://zachleat.com/"
	},
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/11ty"
	},
	"bugs": {
		"url": "https://github.com/11ty/eleventy-base-blog/issues"
	},
	"homepage": "https://github.com/11ty/eleventy-base-blog#readme",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.2",
		"@11ty/eleventy-img": "^6.0.4",
		"@11ty/eleventy-navigation": "^1.0.4",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"@axe-core/playwright": "^4.14.0",
		"@lhci/cli": "^0.16.0",
		"@playwright/test": "^1.64.1",
		"@puppeteer/browsers": "^2.13.2",
		"chrome-launcher": "^1.2.2",
		"cross-env": "^7.0.3",
		"lighthouse": "^12.8.2",
		"luxon": "^3.6.1",
		"prismjs": "^1.30.0",
		"serve": "^14.2.5",
		"zod": "^3.25.67",
		"zod-validation-error": "^3.5.2"
	},
	"dependencies": {
		"@zachleat/heading-anchors": "^1.0.5",
		"firebase": "^12.4.0"
	}
}
